# 数据目录：SQLite 数据库和上传的原图都放在这里
DATA_DIR=data

# OCR 引擎：rapidocr（真实识别，需要 uv sync --extra ocr）或 fake（假数据，开发/联调用）
OCR_ENGINE=rapidocr

# PP-OCRv6 模型档位：tiny | small | medium。默认 small；低配机器用 tiny。依据见 docs/ocr-engine-selection.md
OCR_MODEL_TIER=small

# 前端构建产物目录。设置后后端一并托管前端，一个进程一个端口即可运行（先在 frontend/ 下 npm run build）
STATIC_DIR=../frontend/dist

# 单张图片大小上限（MB）
MAX_UPLOAD_MB=10

# 开发时允许跨域的前端地址，JSON 数组，例如 ["http://localhost:5173"]
CORS_ORIGINS=[]
